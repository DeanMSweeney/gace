# 1. Use the correct PyTorch + CUDA + dev tools base image
FROM pytorch/pytorch:2.4.1-cuda12.4-cudnn9-devel

# 2. Set working directory
WORKDIR /workspace

# 3. Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

# 4. Upgrade pip
RUN pip install --upgrade pip

# 5. Install PyG extensions (manually, not in requirements.txt)
RUN pip install torch_geometric
RUN pip install pyg_lib torch-scatter torch-sparse torch-cluster torch-spline-conv \
  -f https://data.pyg.org/whl/torch-2.4.0+cu124.html

# 6. Copy and install Python requirements (torch*, fairchem-core, etc. NOT included here)
COPY requirements.txt .
RUN pip install --no-cache-dir --no-deps fairchem-core==1.10.0
RUN pip install --no-deps torch-linear-assignment
RUN pip install --no-cache-dir -r requirements.txt

# 7. Copy the codebase
COPY . .

# 8. Install custom package(s) in editable mode (recommended for development)
RUN pip install -e .

# 9. Default to bash
CMD ["bash"]
