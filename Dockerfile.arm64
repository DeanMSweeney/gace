FROM nvcr.io/nvidia/pyg:24.07-py3

WORKDIR /workspace

# Build tools needed to compile PyG extensions from source
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential libopenblas-dev ninja-build && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip (safe)
RUN pip install --no-cache-dir --upgrade pip

# Install torch geometric dependecies 
RUN pip install --no-cache-dir --no-build-isolation \
    pyg_lib torch-scatter torch-sparse torch-cluster torch-spline-conv

# Install requriements and dependecies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-deps torch-linear-assignment
RUN pip install --no-cache-dir --no-deps fairchem-core==1.10.0

# Install local package 
COPY . .
RUN pip install -e .

CMD ["bash"]
